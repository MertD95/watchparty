{
  "name": "watchparty",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node dev-reload.mjs",
    "build:store-package": "node tools/build-store-package.mjs",
    "gen:actions": "node tools/gen-action-contract.mjs",
    "gen:icons": "node tools/generate-icons.mjs",
    "gen:store-assets": "node tools/with-local-server.mjs tools/generate-store-assets.mjs",
    "typecheck:js": "tsc -p jsconfig.typecheck.json",
    "verify:static": "npm run gen:actions -- --check && npm run syntax && npm run typecheck:js",
    "manual:mcp": "node ../watchparty-server/tools/manual-control.mjs",
    "manual:mcp:help": "node ../watchparty-server/tools/manual-control.mjs help",
    "manual:mcp:urls": "node ../watchparty-server/tools/manual-control.mjs urls",
    "manual:mcp:state": "node ../watchparty-server/tools/manual-control.mjs state",
    "manual:mcp:reset": "node ../watchparty-server/tools/manual-control.mjs reset",
    "manual:mcp:slow": "node ../watchparty-server/tools/manual-control.mjs slow",
    "manual:mcp:normal": "node ../watchparty-server/tools/manual-control.mjs normal",
    "manual:mcp:users": "node ../watchparty-server/tools/manual-realtime-users.mjs",
    "debug:invalid-access-key": "node tools/debug-invalid-access-key.mjs",
    "debug:production-smoke": "node tools/production-smoke.mjs",
    "syntax": "node scripts/syntax-check.mjs"
  },
  "devDependencies": {
    "chokidar": "^4.0.0",
    "playwright": "^1.59.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0"
  }
}
